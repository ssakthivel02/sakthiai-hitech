# SakthiAI private-beta runtime profile (chat + projects only). TEMPLATE: nothing here is read by the application.
# Check a filled-in copy with:  node scripts/check-beta-profile.mjs --env-file ./your.env
# Secrets are entered in the host's secret store only. Never commit, never paste in chat.

NODE_ENV=production
SAKTHIAI_DEPLOY_ENV=production            # or preview for the preview service
JWT_SECRET=                               # secret, >= 32 chars, unique per environment
DATABASE_URL=                             # secret
DATABASE_EXPECTED_NAME=                   # the intended database name; the driver refuses any other
DATABASE_CA_CERT_B64=                     # when the managed database requires a CA

# Sign-in: invited users only. Open signup stays off.
AUTH_ALLOWED_SUBJECTS=                    # exact OIDC subjects, comma separated
AUTH_ALLOWED_EMAILS=                      # optional; verified emails only
OWNER_OPEN_ID=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=                       # secret
VITE_OIDC_AUTHORIZATION_URL=
VITE_OIDC_CLIENT_ID=

# Shared, fail-closed request limits. Needs migration 0013 (rateLimitWindows) applied first, through the guarded migrate workflow.
RATE_LIMIT_STORE=mysql
RATE_LIMIT_MAX_INSTANCES=1                # the real instance ceiling

# Uploads and paid Creator stay OFF: leave these UNSET.
# FILE_INGESTION_BACKEND_ENABLED
# CREATOR_PAID_GENERATION_ENABLED / CREATOR_PAID_IMAGE_USERS / CREATOR_PAID_VIDEO_USERS
# No STORAGE_* settings: the enabled paths do not use object storage.

# Hosted model: DISABLED until an owner-approved activation (see config/gateway/sarvam-preview.env.example).
GATEWAY_ALLOW_EXTERNAL=false
GATEWAY_ALLOW_METERED=false

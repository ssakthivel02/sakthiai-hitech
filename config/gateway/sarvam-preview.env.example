# Hosted Sarvam via the pinned endpoint profile. TEMPLATE ONLY: do not activate without owner approval (spend + third-party data transfer).
# Beta candidate, DISABLED until (1) an owner-approved activation and (2) a recorded evaluation (docs: Q8 runbook). Verify with: node scripts/check-beta-profile.mjs --env-file <file> --model-activation
LLM_ENDPOINT_PROFILE=sarvam-chat
LLM_API_URL=https://api.sarvam.ai
# Official docs (read 23 Oct 2026): this chat endpoint serves only `sarvam-105b` and `sarvam-105b-conversations`. Confirm against your own console before use.
LLM_MODEL=sarvam-105b
LLM_API_KEY=            # secret store only; never commit, never paste in chat
LLM_BILLING_MODE=metered_api

GATEWAY_ALLOW_EXTERNAL=false      # flip to true only as part of an approved activation
GATEWAY_ALLOW_METERED=false       # ditto
GATEWAY_STATE_STORE=mysql         # REQUIRED for the beta: the ceiling must survive restarts (needs migration 0005). 'memory' resets on restart.
# (GATEWAY_BUDGET_STORE=memory is for throwaway local runs only.)

# INR rates per 1,000 tokens. Sarvam 105B: Rs 15 in / Rs 60 out per 1M tokens, EXCLUDING GST (cached input Rs 5); reasoning tokens are billed as output.
# Read from docs.sarvam.ai pricing on 25 Oct 2026; the page shows no 'last updated' date, so re-check on the day of activation. Free credit: Rs 100 per verified user.
GATEWAY_COST_PER_1K_PROMPT_TOKENS=0.015
GATEWAY_COST_PER_1K_COMPLETION_TOKENS=0.06
GATEWAY_COST_UNIT=INR

# Daily ceilings per process. Starting values from the Q8 proposal; owner to set.
GATEWAY_EXTERNAL_MAX_REQUESTS_PER_DAY=200
GATEWAY_EXTERNAL_MAX_TOKENS_PER_DAY=1000000
GATEWAY_EXTERNAL_MAX_COST_PER_DAY=100
GATEWAY_MAX_OUTPUT_TOKENS=1024    # per-request output ceiling. Sarvam bills reasoning tokens as output and defaults reasoning ON (medium), so a low ceiling can truncate answers: judge this in the evaluation, do not raise it blindly.

GATEWAY_TIMEOUT_MS=30000
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_TOTAL_DEADLINE_MS=60000

# Hosted Gemini via its OpenAI-compatible route (pinned endpoint profile). TEMPLATE ONLY.
LLM_ENDPOINT_PROFILE=gemini-openai
LLM_API_URL=https://generativelanguage.googleapis.com     # origin only; the profile fixes the path
LLM_MODEL=<confirm exact model id in the provider's current list>
LLM_API_KEY=            # secret store only. Use a PAID-tier key in a dedicated project: free-tier data may be used by the provider to improve products.
LLM_BILLING_MODE=metered_api

GATEWAY_ALLOW_EXTERNAL=false
GATEWAY_ALLOW_METERED=false
GATEWAY_BUDGET_STORE=memory

# Estimated USD rates per 1,000 tokens (Gemini 3.5 Flash-Lite paid tier: $0.30 in / $2.50 out per 1M tokens, public pricing page, 18 Oct 2026).
GATEWAY_COST_PER_1K_PROMPT_TOKENS=0.0003
GATEWAY_COST_PER_1K_COMPLETION_TOKENS=0.0025
GATEWAY_COST_UNIT=USD

GATEWAY_EXTERNAL_MAX_REQUESTS_PER_DAY=200
GATEWAY_EXTERNAL_MAX_TOKENS_PER_DAY=1000000
GATEWAY_EXTERNAL_MAX_COST_PER_DAY=1
GATEWAY_MAX_OUTPUT_TOKENS=1024
# NOTE: the Gemini compatibility page does not document max_tokens; the adapter sends it. Confirm acceptance in the owner-approved probe.

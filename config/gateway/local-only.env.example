# Self-hosted runtime only. No external provider, no spend, no third-party data transfer.
LOCAL_LLM_API_URL=http://127.0.0.1:11434      # Ollama/vLLM (a trailing /v1 is honoured)
LOCAL_LLM_MODEL=<model name as served>
LOCAL_LLM_API_KEY=
# Only if the endpoint is NOT on this machine: the exact private-network host or IP, e.g. 10.0.0.5 (no wildcards/ports). Public hosts are refused.
# LOCAL_LLM_ALLOWED_HOSTS=
LOCAL_LLM_PROFILE=sakthi-local-general
GATEWAY_ALLOW_EXTERNAL=false
GATEWAY_ALLOW_METERED=false

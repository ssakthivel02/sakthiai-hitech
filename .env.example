# Core server
NODE_ENV=development
VITE_APP_ID=sakthiai
JWT_SECRET=replace-with-a-long-random-secret

# MySQL runtime. For Aiven preview, use database sakthiai_preview and
# provide the Aiven project CA certificate as base64. Never commit real values.
DATABASE_URL=
DATABASE_EXPECTED_NAME=sakthiai_preview
DATABASE_CA_CERT_B64=
OWNER_OPEN_ID=

# Provider-neutral OpenID Connect / OAuth 2.0 authentication
# Frontend uses the authorization endpoint; backend performs token exchange.
VITE_OIDC_AUTHORIZATION_URL=
VITE_OIDC_CLIENT_ID=sakthiai
VITE_OIDC_SCOPES=openid profile email
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=sakthiai
# Optional exact registered callback URL, e.g. https://app.example.com/api/oauth/callback
OIDC_REDIRECT_URI=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=oidc

# Provider-neutral OpenAI-compatible LLM runtime
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Self-hosted embeddings (OpenAI-compatible /v1/embeddings: Ollama, vLLM, llama.cpp --embedding). Preferred.
LOCAL_EMBEDDING_API_URL=
LOCAL_EMBEDDING_MODEL=
LOCAL_EMBEDDING_API_KEY=
LOCAL_EMBEDDING_DIMENSIONS=
# Optional external embedding provider: used ONLY when EMBEDDING_ALLOW_EXTERNAL=true (chunk text leaves the platform).
EMBEDDING_ALLOW_EXTERNAL=
EMBEDDING_DIMENSIONS=
EMBEDDING_MAX_ATTEMPTS=2
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=8000

# SakthiAI Creator — first real video provider adapter.
# Keep credentials out of Git. Google Veo is optional/replaceable and must not
# become a hard product dependency. Leave blank to keep the adapter disabled.
GEMINI_API_KEY=
GOOGLE_VEO_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Generic S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Provider Gateway (chat model execution). Everything below is OFF/denied by default.
# Self-hosted / local OpenAI-compatible endpoint (Ollama, vLLM, llama.cpp server, ...). Disabled when unset.
LOCAL_LLM_API_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Catalog profile the local endpoint implements (default sakthi-local-general)
LOCAL_LLM_PROFILE=
# The existing LLM_API_URL/LLM_MODEL/LLM_API_KEY provider is treated as EXTERNAL and is unusable until allowed:
GATEWAY_ALLOW_EXTERNAL=false
# LLM_BILLING_MODE=metered_api (default) | subscription. Metered providers also need all of:
GATEWAY_ALLOW_METERED=false
GATEWAY_BUDGET_STORE=            # "memory" = explicit acknowledgement of the per-instance, non-persistent store
GATEWAY_EXTERNAL_MAX_REQUESTS_PER_DAY=
GATEWAY_EXTERNAL_MAX_TOKENS_PER_DAY=
GATEWAY_EXTERNAL_MAX_COST_PER_DAY=   # needs the three rate settings below, otherwise fails closed
GATEWAY_COST_PER_1K_PROMPT_TOKENS=
GATEWAY_COST_PER_1K_COMPLETION_TOKENS=
GATEWAY_COST_UNIT=
# Timeouts / retries / breaker (optional; safe defaults)
GATEWAY_TIMEOUT_MS=30000
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_TOTAL_DEADLINE_MS=60000
GATEWAY_BREAKER_THRESHOLD=5
GATEWAY_BREAKER_COOLDOWN_MS=30000

# Shared provider policy/budget/breaker state across instances (requires DATABASE_URL + migration 0005). Default: memory (per-process).
GATEWAY_STATE_STORE=

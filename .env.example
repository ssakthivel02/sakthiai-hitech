# Core server
NODE_ENV=development
VITE_APP_ID=sakthiai
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=
OWNER_OPEN_ID=

# Authentication adapter (currently required by the imported auth scaffold)
OAUTH_SERVER_URL=

# Provider-neutral OpenAI-compatible LLM runtime
# Examples: self-hosted vLLM/Ollama gateway/other OpenAI-compatible service.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional provider-neutral embedding runtime
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=8000

# Generic S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

# Core server
NODE_ENV=development
VITE_APP_ID=sakthiai
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=
OWNER_OPEN_ID=

# Provider-neutral OpenID Connect / OAuth 2.0 authentication
# Frontend uses the authorization endpoint; backend performs token exchange.
VITE_OIDC_AUTHORIZATION_URL=
VITE_OIDC_CLIENT_ID=sakthiai
VITE_OIDC_SCOPES=openid profile email
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=sakthiai
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=oidc

# Provider-neutral OpenAI-compatible LLM runtime
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional provider-neutral embedding runtime
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=8000

# Generic S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakthiai.local/schemas/video-quality-review.schema.json",
  "title": "SakthiAI Video Quality Review Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specId",
    "generationRequest",
    "sourcePromptOrStoryboard",
    "output",
    "reviewer",
    "dimensionScores",
    "criticalDefects",
    "decision"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "specId": {"const": "SAI-VIDEO-QUALITY"},
    "generationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "requestId", "gitBlobSha"],
      "properties": {
        "path": {"type": "string", "pattern": "^research/generative-media/.+\\.json$"},
        "requestId": {"type": "string", "pattern": "^VGEN-[A-Z0-9-]+$"},
        "gitBlobSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "sourcePromptOrStoryboard": {"type": "string", "minLength": 1},
    "providerOrLocalAdapterId": {"type": ["string", "null"]},
    "modelIdIfKnown": {"type": ["string", "null"]},
    "generationSettingsIfKnown": {"type": ["object", "null"]},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "width", "height"],
      "properties": {
        "filename": {"type": ["string", "null"]},
        "durationSeconds": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "hasAudio": {"type": ["boolean", "null"]}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reviewTimestamp"],
      "properties": {
        "type": {"enum": ["HUMAN", "ASSISTED_HUMAN"]},
        "reviewTimestamp": {"type": "string", "format": "date-time"},
        "tamilQualityHumanReviewed": {"type": "boolean", "default": false}
      }
    },
    "dimensionScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "VQ-CONTENT-01",
        "VQ-TEMPORAL-01",
        "VQ-IDENTITY-01",
        "VQ-VISUAL-01",
        "VQ-CAMERA-01",
        "VQ-AUDIO-01",
        "VQ-TEXT-01",
        "VQ-DELIVERY-01"
      ],
      "properties": {
        "VQ-CONTENT-01": {"type": "number", "minimum": 0, "maximum": 5},
        "VQ-TEMPORAL-01": {"type": "number", "minimum": 0, "maximum": 5},
        "VQ-IDENTITY-01": {"type": "number", "minimum": 0, "maximum": 5},
        "VQ-VISUAL-01": {"type": "number", "minimum": 0, "maximum": 5},
        "VQ-CAMERA-01": {"type": "number", "minimum": 0, "maximum": 5},
        "VQ-AUDIO-01": {"type": "number", "minimum": 0, "maximum": 5},
        "VQ-TEXT-01": {"type": "number", "minimum": 0, "maximum": 5},
        "VQ-DELIVERY-01": {"type": "number", "minimum": 0, "maximum": 5}
      }
    },
    "criticalDefects": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "notes": {"type": "array", "items": {"type": "string"}},
    "decision": {"enum": ["REJECT", "REGENERATE", "PREVIEW_CANDIDATE", "PUBLISH_CANDIDATE"]}
  }
}

From 2ea4b4f6909dfc11f3084d8294e016531b96b1c5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 4 Oct 2026 23:47:01 +0000
Subject: [PATCH 4/5] ci: guard the existing preview DB migration workflow

preview-db-setup.yml ran 'pnpm db:push' against the non-disposable preview
database with no recovery-point check, no journal check and no backfill.
Add, without changing the migrations themselves:
- a required workflow_dispatch input attesting the Aiven recovery point;
- a read-only pre-check that applied __drizzle_migrations rows are an exact
  in-order prefix of the journal (refuses unexpected state);
- a read-only post-check that all journal entries are applied and no table
  lost rows; a second db:push must leave it unchanged;
- the existing search-text backfill, run twice (second must update 0);
- upload of the pre/post evidence JSON.
Rehearsed locally on MySQL 8.0.46 from a 0004 baseline with legacy rows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ADMGPDEiCj5xPwmjpf1nob
---
 .github/workflows/preview-db-setup.yml | 46 ++++++++++++++++++++++++
 scripts/preview-migration-guard.mjs    | 48 ++++++++++++++++++++++++++
 2 files changed, 94 insertions(+)
 create mode 100644 scripts/preview-migration-guard.mjs

diff --git a/.github/workflows/preview-db-setup.yml b/.github/workflows/preview-db-setup.yml
index 9cb0a05..82f3a83 100644
--- a/.github/workflows/preview-db-setup.yml
+++ b/.github/workflows/preview-db-setup.yml
@@ -2,6 +2,11 @@ name: SakthiAI Preview DB Setup
 
 on:
   workflow_dispatch:
+    inputs:
+      recovery_point:
+        description: "Aiven backup/recovery point taken or confirmed for hitech-preview-mysql immediately before this run (UTC timestamp)"
+        required: true
+        type: string
 
 permissions:
   contents: read
@@ -59,12 +64,53 @@ jobs:
       - name: Install dependencies
         run: pnpm install --frozen-lockfile
 
+      - name: Require an attested pre-migration recovery point
+        env:
+          RECOVERY_POINT: ${{ inputs.recovery_point }}
+        shell: bash
+        run: |
+          set -euo pipefail
+          if ! [[ "${RECOVERY_POINT:-}" =~ ^20[0-9]{2}-[0-9]{2}-[0-9]{2}[T\ ][0-9]{2}:[0-9]{2} ]]; then
+            echo "A UTC recovery-point timestamp (YYYY-MM-DDTHH:MM) is required before migrating the preview database."
+            exit 1
+          fi
+          echo "Recovery point attested: ${RECOVERY_POINT}"
+
       - name: Typecheck
         run: pnpm check
 
+      - name: Pre-migration journal and row-count guard (read-only)
+        run: node scripts/preview-migration-guard.mjs pre
+
       - name: Apply preview schema
         run: pnpm db:push
 
+      - name: Post-migration journal and data-preservation guard (read-only)
+        run: node scripts/preview-migration-guard.mjs post
+
+      - name: Migrator rerun is a no-op
+        shell: bash
+        run: |
+          set -euo pipefail
+          pnpm db:push
+          node scripts/preview-migration-guard.mjs post
+
+      - name: Search-text backfill is complete and idempotent
+        shell: bash
+        run: |
+          set -euo pipefail
+          pnpm db:backfill-search-text | tee /tmp/backfill-1.txt
+          pnpm db:backfill-search-text | tee /tmp/backfill-2.txt
+          grep -q 'BACKFILL_DONE updated=0' /tmp/backfill-2.txt
+
+      - name: Upload preview migration evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: preview-migration-evidence
+          path: reports/staging/preview-migration-*.json
+          if-no-files-found: warn
+
       - name: Verify database connectivity over trusted TLS
         shell: bash
         run: |
diff --git a/scripts/preview-migration-guard.mjs b/scripts/preview-migration-guard.mjs
new file mode 100644
index 0000000..ad9d44d
--- /dev/null
+++ b/scripts/preview-migration-guard.mjs
@@ -0,0 +1,48 @@
+#!/usr/bin/env node
+// Read-only guard around `pnpm db:push` for the preview database (used by preview-db-setup.yml).
+//   pre:  the applied __drizzle_migrations rows must be an exact, in-order prefix of drizzle/meta/_journal.json;
+//         records per-table row counts to reports/staging/preview-migration-pre.json.
+//   post: every journal entry must be applied, in order, and no table may have lost rows since `pre`.
+// Never writes to the database. TLS is verified whenever DATABASE_CA_CERT_B64 is set (the workflow requires it).
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import mysql from "mysql2/promise";
+
+const mode = process.argv[2];
+if (mode !== "pre" && mode !== "post") { console.error("usage: preview-migration-guard.mjs pre|post"); process.exit(2); }
+const url = new URL(process.env.DATABASE_URL ?? "");
+const database = decodeURIComponent(url.pathname.replace(/^\//, ""));
+if (database !== (process.env.DATABASE_EXPECTED_NAME ?? "sakthiai_preview")) { console.error(`GUARD_FAIL: unexpected database ${database || "<none>"}`); process.exit(1); }
+const ca = process.env.DATABASE_CA_CERT_B64;
+const conn = await mysql.createConnection({
+  host: url.hostname, port: url.port ? Number(url.port) : 3306, user: decodeURIComponent(url.username), password: decodeURIComponent(url.password), database,
+  ...(ca ? { ssl: { ca: Buffer.from(ca, "base64").toString("utf8"), rejectUnauthorized: true, minVersion: "TLSv1.2" } } : {}),
+});
+try {
+  const journal = JSON.parse(readFileSync("drizzle/meta/_journal.json", "utf8")).entries;
+  const [tables] = await conn.query("SELECT TABLE_NAME t FROM information_schema.TABLES WHERE TABLE_SCHEMA = ? AND TABLE_TYPE = 'BASE TABLE' ORDER BY TABLE_NAME", [database]);
+  const names = tables.map(r => r.t);
+  const applied = names.includes("__drizzle_migrations")
+    ? (await conn.query("SELECT created_at FROM `__drizzle_migrations` ORDER BY id"))[0].map(r => Number(r.created_at))
+    : [];
+  const prefixOk = applied.length <= journal.length && applied.every((when, i) => when === journal[i].when);
+  const counts = {};
+  for (const t of names.filter(n => n !== "__drizzle_migrations")) counts[t] = Number((await conn.query(`SELECT COUNT(*) n FROM \`${t}\``))[0][0].n);
+  const [[version]] = await conn.query("SELECT VERSION() v");
+  const summary = {
+    mode, engine: version.v, database, applied: applied.length, journal: journal.length,
+    appliedTags: journal.slice(0, applied.length).map(e => e.tag), pendingTags: journal.slice(applied.length).map(e => e.tag), counts,
+  };
+  mkdirSync("reports/staging", { recursive: true });
+  writeFileSync(`reports/staging/preview-migration-${mode}.json`, `${JSON.stringify(summary, null, 2)}\n`);
+  const problems = [];
+  if (!prefixOk) problems.push("applied migrations are not an in-order prefix of the journal; reconcile manually before migrating");
+  if (mode === "post") {
+    if (applied.length !== journal.length) problems.push(`expected ${journal.length} applied migrations, found ${applied.length}`);
+    const pre = JSON.parse(readFileSync("reports/staging/preview-migration-pre.json", "utf8")).counts;
+    for (const [t, n] of Object.entries(pre)) if ((counts[t] ?? -1) < n) problems.push(`table ${t} lost rows: ${n} -> ${counts[t] ?? "missing"}`);
+  }
+  console.log(`PREVIEW_MIGRATION_${mode.toUpperCase()} ${problems.length ? "FAIL" : "PASS"} engine=${version.v} applied=${applied.length}/${journal.length} pending=${summary.pendingTags.join(",") || "none"}`);
+  if (problems.length) { console.error(problems.join("\n")); process.exitCode = 1; }
+} finally {
+  await conn.end();
+}

{
  "version": 1,
  "scope": "controlled-preview",
  "sourceOfTruth": "server/routers.ts",
  "requirements": {
    "retrievalBeforeGeneration": true,
    "noEvidenceAnswer": "INSUFFICIENT_EVIDENCE",
    "noEvidenceCitationsMustBeEmpty": true,
    "noEvidenceMustSkipLlm": true,
    "evidenceOnlySystemInstructionRequired": true,
    "inventedCitationsForbidden": true,
    "modelFailureMustNotClaimGrounding": true,
    "modelFailureState": "MODEL_UNAVAILABLE",
    "behaviouralTests": [
      "server/retrieval.unicode.test.ts",
      "server/chat.grounding.test.ts",
      "server/gateway/gateway.test.ts",
      "server/gateway/boundary.test.ts"
    ],
    "modelCallsMustUseProviderGateway": true
  },
  "claims": {
    "repositoryFailClosedGroundingGuard": true,
    "liveRagAcceptance": false,
    "hallucinationFree": false,
    "productionReady": false
  }
}

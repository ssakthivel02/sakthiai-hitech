{
  "version": 1,
  "scope": "tracked-repository-content",
  "productionApproval": false,
  "allowEnvExample": true,
  "forbidTrackedEnvFiles": true,
  "requireSecretPlaceholders": true,
  "highConfidencePatterns": [
    "private-key-block",
    "github-token",
    "openai-style-secret",
    "google-api-key",
    "aws-access-key"
  ],
  "claimBoundary": {
    "repositoryScanProvesNoHistoricalLeak": false,
    "repositoryScanProvesSecretRotation": false,
    "repositoryScanProvesExternalSecretStoreSafety": false
  }
}
